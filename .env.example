APP_NAME="DA Bridge"
APP_ENV=production
APP_KEY=                      # заполнится командой php artisan key:generate
APP_DEBUG=false
APP_URL=https://shinoii.ru

APP_LOCALE=ru                 # даты в кабинете («5 минут назад») станут русскими
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Moscow    # часовой пояс, в котором показывается время
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=da_bridge
DB_USERNAME=da_bridge          # отдельный пользователь, не root
DB_PASSWORD=СЛОЖНЫЙ_ПАРОЛЬ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=da_bridge_session

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# DonationAlerts
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=https://shinoii.ru/da/callback

# Админка
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=''         # в одинарных кавычках

# Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=shinoii.ru
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
